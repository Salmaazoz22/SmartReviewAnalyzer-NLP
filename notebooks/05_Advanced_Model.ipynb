            "X shape: (49582, 100)\n",
            "y distribution: (array([0, 1]), array([24698, 24884]))\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "2.  Reshape for LSTM"
      ],
      "metadata": {
        "id": "l5Y99IhsEZCe"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "X = X.reshape(X.shape[0], 1, X.shape[1])\n",
        "print(\"X reshaped:\", X.shape)"
      ],
      "metadata": {
        "id": "9QJVKVMfw2Vf",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "3fae834a-bd35-488e-c29d-46fc1688f11c"

[0].legend()\n","\n","axes[1].plot(bert_train_loss_history, marker=\"o\", color=\"orange\", label=\"Train Loss\")\n","axes[1].set_title(\"Loss vs Epoch\")\n","axes[1].set_xlabel(\"Epoch\")\n","axes[1].set_ylabel(\"Loss\")\n","axes[1].legend()\n","\n","plt.tight_layout()\n","plt.savefig(\"bert_training_curves.png\", dpi=150)\n","plt.show()"],"metadata":{"id":"IIt5Y8KrIQah","colab":{"base_uri":"https://localhost:8080/","height":407},"outputId":"35e40f89-a46a-42c0-b144-08120108dbec"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x400 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["## **Compare both models LSTM & BERT**"],"metadata":{"id":"caK6vGOrCvfa"}},{"cell_type":"code","source":["from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n","\n","# LSTM metrics\n","lstm_metrics = {\n","    \"Accuracy\":  accuracy_score(y_test, y_pred),\n","    \"Precision\": precision_score(y_test, y_pred),\n","    \"Recall\":    recall_score(y_test, y_pred),\n","    \"F1-Score\":  f1_score(y_test, y_pred)\n","}\n","\n","# BERT metrics\n","bert_metrics = {\n","    \"Accuracy\":  accuracy_score(bert_labels_true, bert_preds),\n","    \"Precision\": precision_score(bert_labels_true, bert_preds),\n","    \"Recall\":    recall_score(bert_labels_true, bert_preds),\n","    \"F1-Score\":  f1_score(bert_labels_true, bert_preds)\n","}\n","\n","metrics = [\"Accuracy\", \"Precision\", \"Recall\", \"F1-Score\"]\n","print(f\"{'Metric':<12} {'LSTM':>10} {'BERT':>10}\")\n","print(\"-\" * 34)\n","for m in metrics:\n","    print(f\"{m:<12} {lstm_metrics[m]:>10.4f} {bert_metrics[m]:>10.4f}\")"],"metadata":{"id":"BzuocUDZC4p1","colab":{"base_uri":"https://localhost:8080/"},"outputId":"a33318b6-faea-4d8e-9fe6-0be87e6e146f"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Metric             LSTM       BERT\n","----------------------------------\n","Accuracy         0.8541     0.8937\n","Precision        0.8770     0.8897\n","Recall           0.8250     0.8997\n","F1-Score         0.8502     0.8947\n"]}]},{"cell_type":"markdown","source":["## **Comparison bar chart**"],"metadata":{"id":"Bqg9cbRnIqOJ"}},{"cell_type":"code","source":["x = np.arange(len(metrics))\n","width = 0.35\n","\n","fig, ax = plt.subplots(figsize=(9, 5))\n","bars1 = ax.bar(x - width/2, [lstm_metrics[m] for m in metrics],\n","               width, label=\"LSTM\", color=\"steelblue\")\n","bars2 = ax.bar(x + width/2, [bert_metrics[m] for m in metrics],\n","               width, label=\"BERT\", color=\"coral\")\n","\n","ax.set_ylabel(\"Score\")\n","ax.set_title(\"LSTM vs BERT — Performance Comparison\")\n","ax.set_xticks(x)\n","ax.set_xticklabels(metrics)\n","ax.set_ylim(0.7, 1.0)\n","ax.legend()\n","ax.bar_label(bars1, fmt=\"%.3f\", padding=3, fontsize=9)\n","ax.bar_label(bars2, fmt=\"%.3f\", padding=3, fontsize=9)\n","\n","plt.tight_layout()\n","plt.savefig(\"model_comparison.png\", dpi=150)\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":507},"id":"YtjjnhcXKl_0","outputId":"ca2fd71e-9c17-41ec-9dd1-50714e7f371d"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":[],"metadata":{"id":"sliyt_vsyphY"}}]}

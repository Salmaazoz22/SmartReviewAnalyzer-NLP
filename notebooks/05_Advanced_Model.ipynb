    {
      "cell_type": "markdown",
      "source": [
        "## **LSTM Model**"
      ],
      "metadata": {
        "id": "PgTI1vNtr6MT"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        " 1. Load word2vec_vectors"
      ],
      "metadata": {
        "id": "WLU6OQoArqiG"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "with open(\"word2vec_vectors.pkl\", \"rb\") as f:\n",
        "    data = pickle.load(f)\n",
        "\n",
        "X = data[\"X\"]\n",
        "y = data[\"y\"]\n",
        "\n",
        "# Check what labels look like\n",
        "print(\"Label sample:\", y[:5])\n",
        "print(\"Label dtype:\", y.dtype)\n",
        "\n",
        "# Fix labels to 0/1\n",
        "y = (y == \"positive\").astype(int)\n",
        "\n",
        "print(\"X shape:\", X.shape)        # e.g. (50000, 100)\n",
        "print(\"y distribution:\", np.unique(y, return_counts=True))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "MD0A79CMrfAg",
        "outputId": "fabffdad-f611-4fc2-f49c-5af2f27ccaa4"
      },
      "execution_count": null,

    {
      "cell_type": "markdown",
      "source": [
        "1.  Load raw text\n",
        "- BERT needs the original text, Unlike LSTM needs Word2Vec vectors"
      ],
      "metadata": {
        "id": "ls3Uh_JsCCpA"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "df = pd.read_csv(\"processed_text.csv\")\n",
        "\n",
        "print(df.columns)\n",
        "print(df.head())"

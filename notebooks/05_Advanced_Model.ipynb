          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "texts = df[\"processed_text\"].tolist()\n",
        "labels_raw = df[\"sentiment\"].tolist()\n",
        "\n",
        "label_map = {\"positive\": 1, \"negative\": 0,\n",
        "             \"Positive\": 1, \"Negative\": 0}\n",
        "bert_labels = [label_map[l] if isinstance(l, str) else int(l) for l in labels_raw]"
      ],
      "metadata": {
        "id": "MerZTRi3BOXM"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "2. Tokenize & split"
      ],
      "metadata": {
        "id": "wHnXRzvsCXHL"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "tokenizer = BertTokenizer.from_pretrained(\"bert-base-uncased\")\n",
        "\n",
        "train_texts, test_texts, bert_train_labels, bert_test_labels = train_test_split(\n",
        "    texts, bert_labels,\n",
        "    test_size=0.2,\n",
        "    random_state=42,\n",
        "    stratify=bert_labels\n",
        ")\n",
        "\n",
        "train_encodings = tokenizer(train_texts, truncation=True, padding=True,\n",
        "                             max_length=128, return_tensors=\"pt\")\n",
        "test_encodings  = tokenizer(test_texts,  truncation=True, padding=True,\n",
        "                             max_length=128, return_tensors=\"pt\")"
      ],
